# Usar imagen oficial de PHP con Apache
FROM php:8.1-apache

# Habilitar mod_rewrite para URLs amigables
RUN a2enmod rewrite

# Instalar extensiones PHP necesarias
RUN docker-php-ext-install mysqli pdo pdo_mysql
RUN apt-get update && apt-get install -y \
    libcurl4-openssl-dev \
    && docker-php-ext-install curl

# Habilitar display_errors para debug
RUN echo 'display_errors = On' >> /usr/local/etc/php/conf.d/docker-php-ext-display_errors.ini \
    && echo 'error_reporting = E_ALL' >> /usr/local/etc/php/conf.d/docker-php-ext-display_errors.ini

# Configurar Apache ANTES de copiar archivos
RUN echo '<Directory /var/www/html/>\n\
    Options Indexes FollowSymLinks\n\
    AllowOverride All\n\
    Require all granted\n\
    DirectoryIndex index.php login.php index.html\n\
</Directory>' > /etc/apache2/sites-available/000-default.conf

# Configurar Apache
RUN echo 'ServerName localhost' >> /etc/apache2/apache2.conf

# Copiar todos los archivos del proyecto
COPY . /var/www/html/

# Crear index.php simple si no existe
RUN if [ ! -f /var/www/html/index.php ]; then \
    echo '<?php echo "<h1>Actividad3</h1><a href=\"login.php\">Login</a>"; ?>' > /var/www/html/index.php; \
    fi

# Establecer permisos correctos
RUN chown -R www-data:www-data /var/www/html \
    && chmod -R 755 /var/www/html

# Exponer puerto 80
EXPOSE 80

# Comando por defecto
CMD ["apache2-foreground"]